{
  "name": "teaching-tales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "format": "bunx biome format --write",
    "lint": "bunx tsc --noEmit && next lint",
    "start": "next start",
    "test:api": "node automated-test.js",
    "test:interactive": "node test-runner.js",
    "test:cases": "node test-agent-relationships.js",
    "test:generate-questions": "jest src/app/api/generate-questions/__tests__/ --testEnvironment=node",
    "test:generate-questions:watch": "jest src/app/api/generate-questions/__tests__/ --testEnvironment=node --watch",
    "test:generate-questions:coverage": "jest src/app/api/generate-questions/__tests__/ --testEnvironment=node --coverage",
    "test:integration": "jest src/app/api/generate-questions/__tests__/integration.test.ts --testEnvironment=node",
    "test:integration:real": "INTEGRATION_TEST_REAL_SERVICES=true jest src/app/api/generate-questions/__tests__/integration.test.ts --testEnvironment=node",
    "test:all": "jest src/app/api/generate-questions/__tests__/ --testEnvironment=node"
  },
