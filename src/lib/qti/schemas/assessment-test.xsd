<?xml version="1.0" encoding="UTF-8"?>
<!--
  QTI 3.0 Assessment Test Schema (Placeholder)
  
  This is a placeholder schema file for QTI 3.0 Assessment Test validation.
  In a production implementation, this would be the official QTI 3.0 XSD schema
  from IMS Global Learning Consortium.
  
  Official schemas should be downloaded from:
  https://www.imsglobal.org/question/qtiv3p0/imsqti_v3p0.html
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
           xmlns:qti="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
           elementFormDefault="qualified">

  <!-- Root element for QTI Assessment Test -->
  <xs:element name="qti-assessment-test" type="qti:AssessmentTestType"/>

  <!-- Assessment Test Type Definition -->
  <xs:complexType name="AssessmentTestType">
    <xs:sequence>
      <xs:element name="qti-outcome-declaration" type="qti:OutcomeDeclarationType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="qti-test-part" type="qti:TestPartType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="identifier" type="xs:string" use="required"/>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="time-limits" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- Test Part Type Definition -->
  <xs:complexType name="TestPartType">
    <xs:sequence>
      <xs:element name="qti-assessment-section" type="qti:AssessmentSectionType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="identifier" type="xs:string" use="required"/>
    <xs:attribute name="navigation-mode" type="xs:string" use="optional"/>
    <xs:attribute name="submission-mode" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- Assessment Section Type Definition -->
  <xs:complexType name="AssessmentSectionType">
    <xs:sequence>
      <xs:element name="qti-rubric-block" type="xs:string" minOccurs="0"/>
      <xs:element name="qti-assessment-item-ref" type="qti:AssessmentItemRefType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="qti-assessment-section" type="qti:AssessmentSectionType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="identifier" type="xs:string" use="required"/>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="visible" type="xs:boolean" use="optional"/>
  </xs:complexType>

  <!-- Assessment Item Reference Type Definition -->
  <xs:complexType name="AssessmentItemRefType">
    <xs:sequence>
      <xs:element name="qti-branch-rule" type="qti:BranchRuleType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="identifier" type="xs:string" use="required"/>
    <xs:attribute name="href" type="xs:anyURI" use="required"/>
    <xs:attribute name="category" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- Branch Rule Type Definition -->
  <xs:complexType name="BranchRuleType">
    <xs:sequence>
      <xs:element name="qti-pre-condition" type="qti:PreConditionType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="target" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Pre-Condition Type Definition -->
  <xs:complexType name="PreConditionType">
    <xs:choice>
      <xs:element name="qti-and" type="qti:AndType"/>
      <xs:element name="qti-or" type="qti:OrType"/>
      <xs:element name="qti-equal" type="qti:EqualType"/>
      <xs:element name="qti-variable" type="qti:VariableType"/>
    </xs:choice>
  </xs:complexType>

  <!-- Logical AND Type Definition -->
  <xs:complexType name="AndType">
    <xs:sequence>
      <xs:element name="qti-equal" type="qti:EqualType" minOccurs="2" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Logical OR Type Definition -->
  <xs:complexType name="OrType">
    <xs:sequence>
      <xs:element name="qti-equal" type="qti:EqualType" minOccurs="2" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Equal Comparison Type Definition -->
  <xs:complexType name="EqualType">
    <xs:sequence>
      <xs:element name="qti-variable" type="qti:VariableType"/>
      <xs:element name="qti-base-value" type="qti:BaseValueType"/>
    </xs:sequence>
    <xs:attribute name="tolerance-mode" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- Variable Type Definition -->
  <xs:complexType name="VariableType">
    <xs:attribute name="identifier" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Base Value Type Definition -->
  <xs:complexType name="BaseValueType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="base-type" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Outcome Declaration Type Definition -->
  <xs:complexType name="OutcomeDeclarationType">
    <xs:attribute name="identifier" type="xs:string" use="required"/>
    <xs:attribute name="base-type" type="xs:string" use="required"/>
    <xs:attribute name="cardinality" type="xs:string" use="optional"/>
  </xs:complexType>

</xs:schema>